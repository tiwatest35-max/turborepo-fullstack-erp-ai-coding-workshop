// Prisma schema: https://www.prisma.io/docs/orm/prisma-schema
//
// Only the auth models ship with the starter. We will design the ERP data model together in the workshop.
// After adding/changing a model run:  pnpm db:migrate --name <describe-the-change>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PURCHASING
  STORE_EMPLOYEE
  MANAGER
}

model Store {
  id                String                    @id @default(cuid())
  code              String                    @unique
  name              String
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  users             User[]
  reorderThresholds ProductReorderThreshold[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  purchaseOrders    PurchaseOrder[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// Written by hashPassword() from @erp/database. Never returned by the API.
  passwordHash String
  role         Role     @default(STORE_EMPLOYEE)
  /// The store a store-bound user may act in. Null for ADMIN and MANAGER.
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
}

model Supplier {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  contactName  String?
  contactPhone String?
  contactEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model Product {
  id                 String                    @id @default(cuid())
  /// Unique across the organization (MD-01).
  sku                String                    @unique
  name               String
  category           String
  unit               String
  /// THB, never negative (MD-02). Enforced by the contract schema.
  sellingPrice       Decimal                   @db.Decimal(12, 2)
  /// Deactivated products stay in lists and search (MD-02).
  active             Boolean                   @default(true)
  reorderThresholds  ProductReorderThreshold[]
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
}

/// The reorder threshold of one product in one store (MD-01). Whole units, never negative (MD-02).
model ProductReorderThreshold {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id])
  threshold Int

  @@id([productId, storeId])
}

/// Why a product's stock in a store went up or down (INV-02).
enum StockMovementType {
  /// The balance a store started with.
  OPENING
  RECEIPT
  SALE
  ADJUSTMENT
}

/// The current stock of one product in one store (INV-01). Whole units.
/// The migration adds CHECK ("quantity" >= 0), so a balance can never go negative (INV-03).
/// Only StockLedgerService writes it, in the same transaction as the movement that explains it.
model StockBalance {
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([productId, storeId])
}

/// One line of the append-only stock ledger (INV-02). The migration adds a trigger that
/// rejects UPDATE and DELETE, so a confirmed movement cannot be edited or deleted.
/// A balance equals the sum of its movements (INV-03); the first one is the OPENING balance.
model StockMovement {
  id                   String            @id @default(cuid())
  productId            String
  product              Product           @relation(fields: [productId], references: [id])
  /// SKU and name as they were when the movement happened (TOR 4.3).
  productSku           String
  productName          String
  storeId              String
  store                Store             @relation(fields: [storeId], references: [id])
  /// Positive for an increase, negative for a decrease. Never zero.
  quantityChange       Int
  balanceBefore        Int
  balanceAfter         Int
  movementType         StockMovementType
  /// The kind of document that caused it, e.g. OPENING_BALANCE, GOODS_RECEIPT, SALE.
  sourceDocumentType   String
  /// The document number from DocumentSequence. Null for an opening balance.
  sourceDocumentNumber String?
  actorId              String
  actor                User              @relation(fields: [actorId], references: [id])
  createdAt            DateTime          @default(now())

  @@index([productId, storeId, createdAt])
  @@index([createdAt])
}

/// The last number handed out for each document prefix, e.g. GR or SL. DocumentNumberingService
/// bumps it with one atomic statement, so two documents never share a number.
model DocumentSequence {
  prefix    String @id
  lastValue Int    @default(0)
}

/// Where a purchase order is in its life (PO-02). Only the first two exist so far; approval,
/// receiving, rejection and cancellation add theirs with their own tickets.
enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
}

/// A purchase order for one supplier and one destination store (MD-03, PO-01). Creating,
/// editing or submitting one never changes stock (PO-02).
model PurchaseOrder {
  id                  String              @id @default(cuid())
  /// From DocumentNumberingService, e.g. PO-000001. Unique (TOR 4.3).
  number              String              @unique
  status              PurchaseOrderStatus @default(DRAFT)
  supplierId          String
  supplier            Supplier            @relation(fields: [supplierId], references: [id])
  storeId             String
  store               Store               @relation(fields: [storeId], references: [id])
  /// A calendar date, no time of day.
  expectedReceiptDate DateTime            @db.Date
  createdById         String
  createdBy           User                @relation(fields: [createdById], references: [id])
  /// Null while the order is a draft.
  submittedAt         DateTime?
  lines               PurchaseOrderLine[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([createdAt])
}

/// One product on a purchase order (PO-01). SKU, name and unit are copied from the product
/// when the line is saved, so later product edits never change the document (TOR 4.3).
/// A line pointing at a product is what locks that product's SKU (MD-01).
model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  sku             String
  productName     String
  unit            String
  /// Whole units, always above zero. The migration adds CHECK ("quantity" > 0).
  quantity        Int
  /// The purchase price per unit in THB. The migration adds CHECK ("unitPrice" >= 0).
  unitPrice       Decimal       @db.Decimal(12, 2)

  /// A product appears once per order (PO-01).
  @@unique([purchaseOrderId, productId])
  @@index([productId])
}
