// Prisma schema: https://www.prisma.io/docs/orm/prisma-schema
//
// Only the auth models ship with the starter. We will design the ERP data model together in the workshop.
// After adding/changing a model run:  pnpm db:migrate --name <describe-the-change>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PURCHASING
  STORE_EMPLOYEE
  MANAGER
}

model Store {
  id                String                    @id @default(cuid())
  code              String                    @unique
  name              String
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  users             User[]
  reorderThresholds ProductReorderThreshold[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  sales             Sale[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// Written by hashPassword() from @erp/database. Never returned by the API.
  passwordHash String
  role         Role     @default(STORE_EMPLOYEE)
  /// The store a store-bound user may act in. Null for ADMIN and MANAGER.
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  decidedOrders  PurchaseOrder[] @relation("PurchaseOrderDecidedBy")
  auditLogs      AuditLog[]
  goodsReceipts  GoodsReceipt[]
  sales          Sale[]
}

model Supplier {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  contactName  String?
  contactPhone String?
  contactEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model Product {
  id                 String                    @id @default(cuid())
  /// Unique across the organization (MD-01).
  sku                String                    @unique
  name               String
  category           String
  unit               String
  /// THB, never negative (MD-02). Enforced by the contract schema.
  sellingPrice       Decimal                   @db.Decimal(12, 2)
  /// Deactivated products stay in lists and search (MD-02).
  active             Boolean                   @default(true)
  reorderThresholds  ProductReorderThreshold[]
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
  saleLines          SaleLine[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
}

/// The reorder threshold of one product in one store (MD-01). Whole units, never negative (MD-02).
model ProductReorderThreshold {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id])
  threshold Int

  @@id([productId, storeId])
}

/// Why a product's stock in a store went up or down (INV-02).
enum StockMovementType {
  /// The balance a store started with.
  OPENING
  RECEIPT
  SALE
  ADJUSTMENT
}

/// The current stock of one product in one store (INV-01). Whole units.
/// The migration adds CHECK ("quantity" >= 0), so a balance can never go negative (INV-03).
/// Only StockLedgerService writes it, in the same transaction as the movement that explains it.
model StockBalance {
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([productId, storeId])
}

/// One line of the append-only stock ledger (INV-02). The migration adds a trigger that
/// rejects UPDATE and DELETE, so a confirmed movement cannot be edited or deleted.
/// A balance equals the sum of its movements (INV-03); the first one is the OPENING balance.
model StockMovement {
  id                   String            @id @default(cuid())
  productId            String
  product              Product           @relation(fields: [productId], references: [id])
  /// SKU and name as they were when the movement happened (TOR 4.3).
  productSku           String
  productName          String
  storeId              String
  store                Store             @relation(fields: [storeId], references: [id])
  /// Positive for an increase, negative for a decrease. Never zero.
  quantityChange       Int
  balanceBefore        Int
  balanceAfter         Int
  movementType         StockMovementType
  /// The kind of document that caused it, e.g. OPENING_BALANCE, GOODS_RECEIPT, SALE.
  sourceDocumentType   String
  /// The document number from DocumentSequence. Null for an opening balance.
  sourceDocumentNumber String?
  actorId              String
  actor                User              @relation(fields: [actorId], references: [id])
  createdAt            DateTime          @default(now())

  @@index([productId, storeId, createdAt])
  @@index([createdAt])
}

/// The last number handed out for each document prefix, e.g. GR or SL. DocumentNumberingService
/// bumps it with one atomic statement, so two documents never share a number.
model DocumentSequence {
  prefix    String @id
  lastValue Int    @default(0)
}

/// Where a purchase order is in its life (PO-02). The allowed moves between them are in
/// the API's purchase-order status table; receiving moves an order on to PARTIALLY_RECEIVED
/// and COMPLETED with its own ticket.
enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  COMPLETED
  REJECTED
  CANCELLED
}

/// What an audited action decided. Later audited actions add their outcomes with their tickets.
enum AuditOutcome {
  APPROVED
  REJECTED
}

/// A purchase order for one supplier and one destination store (MD-03, PO-01). Creating,
/// editing or submitting one never changes stock (PO-02).
model PurchaseOrder {
  id                  String              @id @default(cuid())
  /// From DocumentNumberingService, e.g. PO-000001. Unique (TOR 4.3).
  number              String              @unique
  status              PurchaseOrderStatus @default(DRAFT)
  supplierId          String
  supplier            Supplier            @relation(fields: [supplierId], references: [id])
  storeId             String
  store               Store               @relation(fields: [storeId], references: [id])
  /// A calendar date, no time of day.
  expectedReceiptDate DateTime            @db.Date
  createdById         String
  createdBy           User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  /// Null while the order is a draft.
  submittedAt         DateTime?
  /// Who approved, rejected or cancelled the order, and when (PO-03, PO-04). Null until then.
  decidedById         String?
  decidedBy           User?               @relation("PurchaseOrderDecidedBy", fields: [decidedById], references: [id])
  decidedAt           DateTime?
  /// Why it was rejected or cancelled. Null for an approval and until a decision is made.
  decisionReason      String?
  lines               PurchaseOrderLine[]
  goodsReceipts       GoodsReceipt[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([createdAt])
}

/// One product on a purchase order (PO-01). SKU, name and unit are copied from the product
/// when the line is saved, so later product edits never change the document (TOR 4.3).
/// A line pointing at a product is what locks that product's SKU (MD-01).
model PurchaseOrderLine {
  id               String             @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product            @relation(fields: [productId], references: [id])
  sku              String
  productName      String
  unit             String
  /// Whole units, always above zero. The migration adds CHECK ("quantity" > 0).
  quantity         Int
  /// The purchase price per unit in THB. The migration adds CHECK ("unitPrice" >= 0).
  unitPrice        Decimal            @db.Decimal(12, 2)
  /// How much of `quantity` goods receipts have received so far (GR-02). Only goods receipt
  /// confirmation changes it. The migration adds CHECK (0 <= "receivedQuantity" <= "quantity"),
  /// so receipts can never exceed what was ordered, however they are written (GR-05).
  receivedQuantity Int                @default(0)
  receiptLines     GoodsReceiptLine[]

  /// A product appears once per order (PO-01).
  @@unique([purchaseOrderId, productId])
  @@index([productId])
}

/// One confirmed delivery against an approved purchase order (GR-03). There is no draft state:
/// a receipt exists because it was confirmed. The migration adds a trigger that rejects UPDATE
/// and DELETE, so a confirmed receipt cannot be edited or cancelled (GR-05).
model GoodsReceipt {
  id              String             @id @default(cuid())
  /// From DocumentNumberingService, e.g. GR-000001. Unique (TOR 4.3).
  number          String             @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  /// The order's destination store, copied so the receipt stands on its own.
  storeId         String
  store           Store              @relation(fields: [storeId], references: [id])
  receivedById    String
  receivedBy      User               @relation(fields: [receivedById], references: [id])
  /// The system confirmation time. The client cannot set it (Q-03: no backdating).
  receivedAt      DateTime           @default(now())
  lines           GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([storeId, receivedAt])
}

/// One product on a goods receipt. Only lines with a quantity above zero are saved.
/// SKU, name and unit are copied from the purchase order line (TOR 4.3).
model GoodsReceiptLine {
  id                  String            @id @default(cuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id])
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  productId           String
  product             Product           @relation(fields: [productId], references: [id])
  sku                 String
  productName         String
  unit                String
  /// Whole units received in this delivery. The migration adds CHECK ("quantity" > 0).
  quantity            Int

  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
}

/// One confirmed sale in one store (SAL-03). There is no stored draft: a sale exists because it
/// was confirmed, and the cart before that lives in the browser. The migration adds a trigger that
/// rejects UPDATE and DELETE, so a confirmed sale cannot be edited, cancelled or returned (SAL-04).
model Sale {
  id       String     @id @default(cuid())
  /// From DocumentNumberingService, e.g. SL-000001. Unique (TOR 4.3).
  number   String     @unique
  /// The seller's assigned store, taken from the signed-in user, never from the request.
  storeId  String
  store    Store      @relation(fields: [storeId], references: [id])
  soldById String
  soldBy   User       @relation(fields: [soldById], references: [id])
  /// The system confirmation time. The client cannot set it. Reports use it (TOR 6.2).
  soldAt   DateTime   @default(now())
  lines    SaleLine[]

  @@index([storeId, soldAt])
}

/// One product on a sale. SKU, name, unit and the selling price are copied from the product when
/// the sale is confirmed, so later product edits never change the document (SAL-01, TOR 4.3).
model SaleLine {
  id          String  @id @default(cuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  sku         String
  productName String
  unit        String
  /// Whole units sold, always above zero. The migration adds CHECK ("quantity" > 0).
  quantity    Int
  /// The product's selling price per unit in THB at confirmation, frozen here. The migration adds
  /// CHECK ("unitPrice" >= 0).
  unitPrice   Decimal @db.Decimal(12, 2)

  /// A product appears once per sale.
  @@unique([saleId, productId])
  @@index([productId])
}

/// A client-supplied key that makes one write safe to repeat (GR-04). Sending the same key with
/// the same request returns the first result instead of doing the work again; a new key is a
/// new operation. IdempotencyService is the only writer.
model IdempotencyKey {
  /// What the key was used for, e.g. GOODS_RECEIPT. The same key may be used for different operations.
  operation   String
  key         String
  /// A hash of who asked and what they asked for, so a key reused for a different request is caught.
  requestHash String
  /// The id of the document the first request produced. Null only inside that request's transaction.
  resultId    String?
  createdAt   DateTime @default(now())

  @@id([operation, key])
}

/// One line of the append-only audit log. The migration adds a trigger that rejects UPDATE
/// and DELETE, so a recorded action cannot be edited or deleted. It holds who did what to which
/// document and how it turned out, never passwords, tokens or other secrets.
model AuditLog {
  id                   String       @id @default(cuid())
  actorId              String
  actor                User         @relation(fields: [actorId], references: [id])
  /// The kind of document acted on, e.g. PURCHASE_ORDER.
  sourceDocumentType   String
  /// The document number, e.g. PO-000001.
  sourceDocumentNumber String
  outcome              AuditOutcome
  /// The reason the actor gave. Null when none was asked for.
  reason               String?
  createdAt            DateTime     @default(now())

  @@index([createdAt])
  @@index([sourceDocumentType, sourceDocumentNumber])
}
